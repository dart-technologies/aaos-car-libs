#
# Copy to .env, keep permissions owner-only, and load it only into the operator/gateway process.
# The Android hosts must never receive vendor credentials. Empty values are intentional.

# Paid speech evidence (scripts/prepare-elevenlabs-demo-audio.py).
ELEVENLABS_API_KEY=
# Distinct voices per role; empty uses the persona defaults. ELEVENLABS_VOICE_ID overrides all roles.
ELEVENLABS_NAVIGATOR_VOICE_ID=
ELEVENLABS_USER_VOICE_ID=
ELEVENLABS_VOICE_ID=

# Dev gateway (tools/a2ui-gateway) vendor keys. Configure only the providers in use; a provider
# without a key is skipped. Only these names are read; non-empty process values override them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Accepted instead of GEMINI_API_KEY.
GOOGLE_API_KEY=
XAI_API_KEY=
# Meta Model API (Muse). Meta's docs call it MODEL_API_KEY; the gateway reads only this name.
META_API_KEY=
# Bearer token the dev gateway requires; Host B's debug lane sends the default, a2ui-dev-local.
A2UI_GATEWAY_TOKEN=

# Provider-neutral gateway/operator selection; neither APK reads these.
A2UI_AGENT_PROVIDER=claude
A2UI_AGENT_EXECUTION_PROFILE=quality_cached
A2UI_GATEWAY_URL=

# Reproducible AAOS demo selection.
AVD=AAOS_35_1408p_GoogleAPIs
DISPLAY_ID=

# Optional build toggle. Uncomment to include the Flutter bridge. Presence enables it, so never
# write CAR_UXR_WITH_FLUTTER=0 or =false; either omit it or use the exact opt-in below.
# CAR_UXR_WITH_FLUTTER=1
