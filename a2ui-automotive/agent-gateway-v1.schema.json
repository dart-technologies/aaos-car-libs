{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dart.art/schemas/a2ui-agent-gateway-v1.json",
  "$comment": "Copyright (C) 2026 Dart Technologies. Licensed under Apache-2.0.",
  "title": "A2UI OEM agent gateway v1",
  "oneOf": [
    { "$ref": "#/$defs/turn" },
    { "$ref": "#/$defs/actionResult" },
    { "$ref": "#/$defs/surfaceResponse" },
    { "$ref": "#/$defs/actionAcknowledgement" },
    { "$ref": "#/$defs/gatewayError" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,256}$"
    },
    "provider": {
      "enum": ["claude", "chatgpt", "gemini", "grok", "muse"]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "type", "provider", "executionProfile", "sessionId", "turnId", "inputText", "capabilities", "display"],
      "properties": {
        "schema": { "const": "a2ui.gateway.v1" },
        "type": { "const": "turn" },
        "provider": { "$ref": "#/$defs/provider" },
        "executionProfile": {
          "enum": ["quality_cached", "realtime_low_latency"]
        },
        "sessionId": { "$ref": "#/$defs/id" },
        "turnId": { "$ref": "#/$defs/id" },
        "inputText": { "type": "string", "maxLength": 4096 },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["versions", "catalogs"],
          "properties": {
            "versions": { "const": ["v0.9"] },
            "catalogs": { "const": ["automotive"] }
          }
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "activeRestrictions", "trustworthy"],
          "properties": {
            "id": { "type": "integer", "minimum": 0 },
            "activeRestrictions": { "type": "integer", "minimum": 0 },
            "trustworthy": { "type": "boolean" }
          }
        }
      }
    },
    "actionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "type", "provider", "sessionId", "turnId", "surfaceId", "componentId", "actionId", "outcome"],
      "properties": {
        "schema": { "const": "a2ui.gateway.v1" },
        "type": { "const": "actionResult" },
        "provider": { "$ref": "#/$defs/provider" },
        "sessionId": { "$ref": "#/$defs/id" },
        "turnId": { "$ref": "#/$defs/id" },
        "surfaceId": { "$ref": "#/$defs/id" },
        "componentId": { "$ref": "#/$defs/id" },
        "actionId": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["ALLOWED", "CONFIRMED", "REFUSED", "FAILED"] },
        "resultText": { "type": "string", "maxLength": 4096 }
      }
    },
    "surfaceResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "provider", "sessionId", "turnId", "messages"],
      "properties": {
        "schema": { "const": "a2ui.gateway.v1" },
        "provider": { "$ref": "#/$defs/provider" },
        "sessionId": { "$ref": "#/$defs/id" },
        "turnId": { "$ref": "#/$defs/id" },
        "source": {
          "$comment": "live: this turn's vendor call produced it. cache: an exact replay. fallback: served because the vendor failed or missed the deadline.",
          "enum": ["live", "cache", "fallback"]
        },
        "assistantText": { "type": "string", "maxLength": 4096 },
        "messages": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/lifecycleMessage" }
        }
      }
    },
    "actionAcknowledgement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ack", "provider", "sessionId", "turnId"],
      "properties": {
        "schema": { "const": "a2ui.gateway.v1" },
        "ack": { "const": "actionResult" },
        "provider": { "$ref": "#/$defs/provider" },
        "sessionId": { "$ref": "#/$defs/id" },
        "turnId": { "$ref": "#/$defs/id" }
      }
    },
    "gatewayError": {
      "$comment": "Sent only with a non-2xx status; the vehicle never decodes it. detail is a token, never vendor text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "error"],
      "properties": {
        "schema": { "const": "a2ui.gateway.v1" },
        "provider": { "$ref": "#/$defs/provider" },
        "sessionId": { "$ref": "#/$defs/id" },
        "turnId": { "$ref": "#/$defs/id" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": {
              "enum": ["bad_request", "unauthorized", "not_found", "too_large",
                       "provider_unconfigured", "cache_miss", "upstream", "timeout",
                       "refusal", "truncated", "invalid_output", "internal"]
            },
            "detail": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" }
          }
        }
      }
    },
    "lifecycleMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "const": "v0.9" },
        "createSurface": { "$ref": "#/$defs/createSurface" },
        "updateComponents": { "$ref": "#/$defs/updateComponents" },
        "updateDataModel": { "$ref": "#/$defs/updateDataModel" },
        "deleteSurface": { "$ref": "#/$defs/deleteSurface" }
      },
      "oneOf": [
        { "required": ["createSurface"] },
        { "required": ["updateComponents"] },
        { "required": ["updateDataModel"] },
        { "required": ["deleteSurface"] }
      ]
    },
    "createSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "catalogId"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/id" },
        "catalogId": { "$ref": "#/$defs/id" }
      }
    },
    "updateComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "components"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/id" },
        "components": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": ["id", "component"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "component": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "updateDataModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "path", "value"],
      "properties": {
        "surfaceId": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "maxLength": 4096 },
        "value": true
      }
    },
    "deleteSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId"],
      "properties": { "surfaceId": { "$ref": "#/$defs/id" } }
    }
  }
}
