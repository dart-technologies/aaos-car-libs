<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Unlike Host A: no templates host to negotiate with; this renders in process. car-ui-lib
         resolves the OEM's views at runtime through CarUiInstaller, a ContentProvider its manifest
         contributes, and negotiates the plugin version silently in PluginFactoryAdapterV2. -->

    <!-- AAOS-only track: a native car-ui activity; Play distributes it to cars, never phones. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Voice capture: requested on first use, not at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_sort_by_size"
        android:allowBackup="false">

        <!--
          Required: CarUiInstaller acts only on activities whose theme sets carUiActivity, and
          without its factory the CarUiRecyclerView tag (an interface) fails to inflate.
          Theme.CarUi.WithToolbar also adds the OEM-supplied toolbar.
        -->
        <activity
            android:name="art.dart.a2ui.carui.A2uiCarUiActivity"
            android:exported="true"
            android:theme="@style/Theme.CarUi.WithToolbar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Without this the launcher hides the app while the vehicle moves. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!--
          The passenger display's surface, in its own task so starting it there never moves the
          driver's. Exported because the system (or `am start - -display <id>`) places it: an app
          cannot open a window on a private display it is not already on. It shows an idle card
          unless a debuggable build asks it to play, and decides video by its own display's reading.
        -->
        <activity
            android:name="art.dart.a2ui.carui.A2uiPassengerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="art.dart.a2ui.carui.passenger"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
