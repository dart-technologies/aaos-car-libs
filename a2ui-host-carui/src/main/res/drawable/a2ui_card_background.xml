<!-- A surface card; pressed state ripples, disabled rows are dimmed by the adapter. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/a2ui_card_radius" />
            <solid android:color="@color/a2ui_brand_card_surface" />
            <stroke android:width="1dp" android:color="@color/a2ui_brand_card_stroke" />
        </shape>
    </item>
</ripple>
