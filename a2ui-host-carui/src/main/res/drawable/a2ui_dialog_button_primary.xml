<!-- The emphasised action: a filled accent pill. The ripple also marks rotary focus. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40000000">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/a2ui_brand_accent" />
            <corners android:radius="@dimen/a2ui_dialog_button_radius" />
        </shape>
    </item>
</ripple>
