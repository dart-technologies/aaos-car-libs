<!-- The quiet action: an outlined pill. The mask bounds the ripple to the pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#26FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/a2ui_dialog_button_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1.5dp"
                android:color="@color/a2ui_dialog_quiet_stroke" />
            <corners android:radius="@dimen/a2ui_dialog_button_radius" />
        </shape>
    </item>
</ripple>
