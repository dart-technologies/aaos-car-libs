<!-- The confirmation dialog's window: rounded, no inset, so the padding is the layout's alone. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/a2ui_dialog_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/a2ui_dialog_stroke" />
    <corners android:radius="@dimen/a2ui_dialog_radius" />
</shape>
