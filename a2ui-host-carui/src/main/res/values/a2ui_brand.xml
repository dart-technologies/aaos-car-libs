<resources>
    <!-- App-owned presentation chrome only. OEM plugin views retain the vehicle's native theme. -->
    <color name="a2ui_brand_header_surface">#FF101113</color>
    <color name="a2ui_brand_badge_surface">#E6171717</color>
    <color name="a2ui_brand_accent">#FFC8A96A</color>
    <color name="a2ui_brand_on_surface">#FFFFF8EE</color>
    <color name="a2ui_brand_on_surface_muted">#B3FFF8EE</color>
    <color name="a2ui_brand_video_stage">#FF000000</color>
    <!-- Vehicle-state chip fills, one per state so the state reads before the word does: the
         brand green and blue at lower saturation, and a brighter dot of the same hue. -->
    <color name="a2ui_brand_state_parked">#FF2E5C4B</color>
    <color name="a2ui_brand_state_driving">#FF3D567C</color>
    <color name="a2ui_brand_state_safe">#FF804B3A</color>
    <color name="a2ui_brand_state_demo">#FF4B4C55</color>
    <color name="a2ui_brand_state_parked_dot">#FF8FE0B5</color>
    <color name="a2ui_brand_state_driving_dot">#FF9EC1F7</color>
    <color name="a2ui_brand_state_safe_dot">#FFF2B38A</color>
    <color name="a2ui_brand_state_demo_dot">#FFC9CAD3</color>
    <color name="a2ui_brand_strip_surface">#F21B1C20</color>
    <color name="a2ui_brand_panel_surface">#FF17181B</color>
    <color name="a2ui_brand_scrim">#B3000000</color>
    <color name="a2ui_brand_card_surface">#FF1E2024</color>
    <color name="a2ui_brand_card_stroke">#14FFFFFF</color>
    <color name="a2ui_brand_glyph_tile">#FF2A2C31</color>

    <string name="a2ui_brand_toolbar_title">Fifth House · NYC Concierge</string>
    <string name="a2ui_brand_pickup_heading">FIFTH HOUSE · PICKUP</string>
    <string name="a2ui_brand_city_note_heading">FIFTH HOUSE · CITY NOTE</string>
    <string name="a2ui_brand_thinking_title">Thinking…</string>
    <!-- %1$s is the provider's display name. -->
    <string name="a2ui_brand_thinking_body">%1$s is preparing your answer</string>
    <string name="a2ui_brand_media_title">Fifth House city note</string>
    <string name="a2ui_brand_media_artist">Fifth House · DEMO</string>
    <string name="a2ui_brand_video_caption">DEMO generated decoder fixture · not Big Buck Bunny media</string>

    <!-- Vehicle-state chip. Consumer words; the exact mask and the reading's provenance stay in
         the diagnostics strip and the log. A simulated (DEMO) reading says so. -->
    <string name="a2ui_state_parked">Parked</string>
    <string name="a2ui_state_driving">Driving</string>
    <string name="a2ui_state_safe_mode">Safe mode</string>
    <string name="a2ui_state_demo">Simulated</string>
    <string name="a2ui_state_parked_detail">Full experience available</string>
    <string name="a2ui_state_driving_detail">Simplified for the road</string>
    <string name="a2ui_state_safe_waiting_detail">Waiting for the vehicle · essentials only</string>
    <string name="a2ui_state_safe_offline_detail">Vehicle signal lost · essentials only</string>
    <string name="a2ui_state_demo_open_detail">Simulated reading · no limits</string>
    <string name="a2ui_state_demo_restricted_detail">Simulated reading · restricted</string>

    <string name="a2ui_close">Close</string>
    <string name="a2ui_speak">Speak</string>
    <string name="a2ui_confirm">Confirm</string>
    <string name="a2ui_cancel">Cancel</string>

    <!-- Closing card. Bullets and footer are OEM-overridable. -->
    <string name="a2ui_end_card_title">Why OEMs ship A2UI this way</string>
    <string name="a2ui_end_card_bullet_1">The vehicle enforces the policy, and fails closed</string>
    <string name="a2ui_end_card_bullet_2">Any model, with no keys in the car</string>
    <string name="a2ui_end_card_bullet_3">Stock AAOS hosts</string>
    <string name="a2ui_end_card_bullet_4">Auditable gates</string>
    <string name="a2ui_end_card_footer">Built on stock AAOS · any model via the gateway</string>

    <!-- Passenger display. The label is the screen's accessibility name; no header draws it. -->
    <string name="a2ui_passenger_label">Passenger display</string>
    <!-- Idle: a small name above the line, so a viewer knows whose screen this is. -->
    <string name="a2ui_passenger_idle_label">Passenger screen</string>
    <string name="a2ui_passenger_idle">Ready when you are</string>
    <string name="a2ui_passenger_video_credit">Big Buck Bunny © Blender Foundation · CC BY 3.0</string>
    <string name="a2ui_passenger_held">Video is not available on this screen right now</string>

    <style name="A2uiBrandStatusBadge">
        <item name="android:background">@drawable/a2ui_status_badge</item>
        <item name="android:paddingHorizontal">@dimen/a2ui_status_badge_padding_horizontal</item>
        <item name="android:paddingVertical">@dimen/a2ui_status_badge_padding_vertical</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/a2ui_brand_on_surface</item>
        <item name="android:textSize">@dimen/a2ui_status_badge_text_size</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="A2uiBrandSectionHeading">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/a2ui_brand_on_surface</item>
        <item name="android:textSize">@dimen/a2ui_brand_heading_text_size</item>
    </style>

    <!-- Type scale: display > title > body > caption, one family. -->
    <style name="A2uiBrandDisplay">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/a2ui_brand_on_surface</item>
        <item name="android:textSize">@dimen/a2ui_type_display</item>
    </style>

    <style name="A2uiBrandTitle">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/a2ui_brand_on_surface</item>
        <item name="android:textSize">@dimen/a2ui_type_title</item>
    </style>

    <style name="A2uiBrandBody">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/a2ui_brand_on_surface</item>
        <item name="android:textSize">@dimen/a2ui_type_body</item>
    </style>

    <style name="A2uiBrandCaption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/a2ui_brand_on_surface_muted</item>
        <item name="android:textSize">@dimen/a2ui_type_caption</item>
    </style>
</resources>
