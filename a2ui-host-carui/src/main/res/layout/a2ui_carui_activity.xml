  Two lists over identical data. The left one opted in to content limiting; the right one is what
  car-ui-lib gives you by default. Side by side rather than toggled, so the difference is a single
  screenshot rather than a claim about two of them. Visitor surfaces hide the right list and may use
  the visual panel instead; every overlay below is host chrome gated on the pruned tree.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/content_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/diagnostic_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/a2ui_brand_header_surface"
        android:paddingHorizontal="@dimen/a2ui_space_l"
        android:paddingVertical="@dimen/a2ui_space_s"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Vehicle state first, large; provider chip and brand heading opposite. -->
        <LinearLayout
            android:id="@+id/presentation_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/drive_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/a2ui_banner_background"
                android:backgroundTint="@color/a2ui_brand_state_safe"
                android:gravity="center_vertical"
                android:minWidth="360dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/a2ui_banner_padding_horizontal"
                android:paddingVertical="@dimen/a2ui_banner_padding_vertical">

                <View
                    android:id="@+id/drive_banner_dot"
                    android:layout_width="@dimen/a2ui_banner_dot_size"
                    android:layout_height="@dimen/a2ui_banner_dot_size"
                    android:layout_marginEnd="@dimen/a2ui_space_m"
                    android:background="@drawable/a2ui_dot"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/drive_banner_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"
                    android:text="@string/a2ui_state_safe_mode"
                    android:textColor="@color/a2ui_brand_on_surface"
                    android:textSize="@dimen/a2ui_banner_title_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/drive_banner_detail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/a2ui_space_m"
                    android:maxLines="1"
                    android:text="@string/a2ui_state_safe_waiting_detail"
                    android:textColor="@color/a2ui_brand_on_surface"
                    android:textSize="@dimen/a2ui_banner_detail_text_size" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_badge"
                style="@style/A2uiBrandStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/a2ui_space_m"
                android:contentDescription="@string/status_badge_description"
                android:text="@string/status_badge_waiting"
                android:visibility="gone" />

            <TextView
                android:id="@+id/demo_pill"
                style="@style/A2uiBrandStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/a2ui_space_m"
                android:text="@string/a2ui_demo_data"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/voice_hint"
                style="@style/A2uiBrandCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/a2ui_space_m"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/a2ui_ask_by_voice"
                android:visibility="gone" />

            <!-- The heading's place. The change line takes it while it shows, so the line sits in
                 the header band and never covers a card. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/a2ui_space_m"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/surface_heading"
                    style="@style/A2uiBrandSectionHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/a2ui_brand_heading_margin_horizontal"
                    android:gravity="end|center_vertical"
                    android:text="@string/a2ui_brand_pickup_heading" />

                <!-- What changed at the last restriction change. Transient and never
                     interactive. -->
                <TextView
                    android:id="@+id/change_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/a2ui_strip_background"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:paddingHorizontal="@dimen/a2ui_space_m"
                    android:paddingVertical="@dimen/a2ui_space_xs"
                    android:textColor="@color/a2ui_brand_on_surface"
                    android:textSize="@dimen/a2ui_strip_text_size"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/a2ui_diagnostic_detail_margin_top"
            android:fontFamily="monospace"
            android:text="@string/status_placeholder"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/a2ui_diagnostic_text_size"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Shown only when the prune left nothing to draw. A separate view, not a synthetic row,
         because the screen reports row counts read from the adapters. Wording shared via
         A2uiActionBinder.EMPTY_WHILE_DRIVING_NOTE. -->
    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingHorizontal="@dimen/a2ui_space_l"
        android:paddingVertical="@dimen/a2ui_space_s"
        android:textColor="?android:attr/textColorPrimary" />

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/content_columns"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/limited_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/limited_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/a2ui_diagnostic_padding_horizontal"
                android:paddingVertical="@dimen/a2ui_diagnostic_padding_vertical"
                android:textSize="@dimen/a2ui_diagnostic_text_size"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/limited_label" />

            <!-- An interface: CarUiInstaller's inflater factory substitutes the OEM implementation,
                 which lint cannot model, so only this tag is suppressed. -->
            <com.android.car.ui.recyclerview.CarUiRecyclerView
                android:id="@+id/limited_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                tools:ignore="Instantiatable" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/unlimited_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/unlimited_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/a2ui_diagnostic_padding_horizontal"
                android:paddingVertical="@dimen/a2ui_diagnostic_padding_vertical"
                android:textSize="@dimen/a2ui_diagnostic_text_size"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/unlimited_label" />

            <com.android.car.ui.recyclerview.CarUiRecyclerView
                android:id="@+id/unlimited_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                tools:ignore="Instantiatable" />
        </LinearLayout>

        <!-- Visitor surfaces: the same rows as surface cards (CardListAdapter). The start inset
             clears the system's back button, an overlay at the display's left edge. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/card_list"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/a2ui_card_list_inset_start"
            android:paddingEnd="@dimen/a2ui_space_l"
            android:paddingTop="@dimen/a2ui_space_m"
            android:paddingBottom="@dimen/a2ui_space_s"
            android:visibility="gone" />

        <!-- Large imagery for one surviving component (a route map, an arrival hero). Shown only
             while that component is in the pruned tree and the reading allows IMAGE. -->
        <FrameLayout
            android:id="@+id/visual_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="@dimen/a2ui_space_m"
            android:layout_marginEnd="@dimen/a2ui_space_l"
            android:layout_weight="0.62"
            android:background="@drawable/a2ui_panel_background"
            android:visibility="gone">

            <ImageView
                android:id="@+id/visual_panel_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_gravity="bottom"
                android:background="@drawable/a2ui_scrim_bottom" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="@dimen/a2ui_space_l">

                <TextView
                    android:id="@+id/visual_panel_title"
                    style="@style/A2uiBrandTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/visual_panel_caption"
                    style="@style/A2uiBrandCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    </FrameLayout>
</LinearLayout>

    <!-- Parked-only, full-bleed video. A VideoView is added per playback and removed on teardown,
         so a restriction change takes the surface away, not just its pixels. -->
    <FrameLayout
        android:id="@+id/video_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a2ui_brand_video_stage"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/video_caption"
            style="@style/A2uiBrandSectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/a2ui_brand_heading_margin_horizontal"
            android:text="@string/a2ui_brand_video_caption" />

        <Button
            android:id="@+id/video_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/a2ui_brand_heading_margin_horizontal"
            android:text="@string/a2ui_close" />
    </FrameLayout>

    <!-- Parked-only, auto-advancing artwork. Filled by ArtworkSlideshow; removed by refresh() on
         any reading that prunes its component or forbids moving imagery. -->
    <FrameLayout
        android:id="@+id/gallery_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a2ui_brand_video_stage"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/gallery_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/gallery_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="@dimen/a2ui_space_s"
            android:scaleType="fitCenter" />

        <View
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_gravity="bottom"
            android:background="@drawable/a2ui_scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/a2ui_space_xl"
            android:paddingVertical="@dimen/a2ui_space_l">

            <TextView
                android:id="@+id/gallery_title"
                style="@style/A2uiBrandTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/gallery_caption"
                style="@style/A2uiBrandBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/a2ui_space_xs"
                android:maxLines="1" />

            <TextView
                android:id="@+id/gallery_credit"
                style="@style/A2uiBrandCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/a2ui_space_xs"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/gallery_counter"
            style="@style/A2uiBrandStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/a2ui_space_l" />

        <Button
            android:id="@+id/gallery_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/a2ui_space_l"
            android:text="@string/a2ui_close" />
    </FrameLayout>

    <!-- Closing card: static host text, shown only while parked. -->
    <LinearLayout
        android:id="@+id/end_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a2ui_brand_header_surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="96dp"
        android:visibility="gone">

        <View
            android:layout_width="72dp"
            android:layout_height="4dp"
            android:background="@color/a2ui_brand_accent" />

        <TextView
            android:id="@+id/end_card_title"
            style="@style/A2uiBrandDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/a2ui_space_m"
            android:text="@string/a2ui_end_card_title"
            android:textSize="34sp" />

        <LinearLayout
            android:id="@+id/end_card_bullets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/a2ui_space_m"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/end_card_footer"
            style="@style/A2uiBrandCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/a2ui_space_m"
            android:letterSpacing="0.04"
            android:text="@string/a2ui_end_card_footer"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
