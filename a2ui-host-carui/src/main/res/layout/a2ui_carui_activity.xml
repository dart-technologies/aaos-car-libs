  Two lists over identical data. The left one opted in to content limiting; the right one is what
  car-ui-lib gives you by default. Side by side rather than toggled, so the difference is a single
  screenshot rather than a claim about two of them.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/content_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/diagnostic_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/a2ui_brand_header_surface"
        android:paddingHorizontal="@dimen/a2ui_diagnostic_padding_horizontal"
        android:paddingVertical="@dimen/a2ui_diagnostic_padding_vertical"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- One presentation rail: brand heading opposite provenance; per-column labels below. -->
        <LinearLayout
            android:id="@+id/presentation_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status_badge"
                style="@style/A2uiBrandStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/status_badge_description"
                android:text="@string/status_badge_waiting" />

            <TextView
                android:id="@+id/surface_heading"
                style="@style/A2uiBrandSectionHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/a2ui_brand_heading_margin_horizontal"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:text="@string/a2ui_brand_pickup_heading" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/a2ui_diagnostic_detail_margin_top"
            android:fontFamily="monospace"
            android:text="@string/status_placeholder"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="@dimen/a2ui_diagnostic_text_size"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Shown only when the prune left nothing to draw. A separate view, not a synthetic row,
         because the screen reports row counts read from the adapters. Wording shared via
         A2uiActionBinder.EMPTY_WHILE_DRIVING_NOTE. -->
    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingHorizontal="@dimen/a2ui_diagnostic_padding_horizontal"
        android:paddingVertical="@dimen/a2ui_diagnostic_padding_vertical"
        android:textColor="?android:attr/textColorPrimary" />

    <LinearLayout
        android:id="@+id/content_columns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/limited_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/limited_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/a2ui_diagnostic_padding_horizontal"
                android:paddingVertical="@dimen/a2ui_diagnostic_padding_vertical"
                android:textSize="@dimen/a2ui_diagnostic_text_size"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/limited_label" />

            <!-- An interface: CarUiInstaller's inflater factory substitutes the OEM implementation,
                 which lint cannot model, so only this tag is suppressed. -->
            <com.android.car.ui.recyclerview.CarUiRecyclerView
                android:id="@+id/limited_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                tools:ignore="Instantiatable" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/unlimited_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/unlimited_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/a2ui_diagnostic_padding_horizontal"
                android:paddingVertical="@dimen/a2ui_diagnostic_padding_vertical"
                android:textSize="@dimen/a2ui_diagnostic_text_size"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:text="@string/unlimited_label" />

            <com.android.car.ui.recyclerview.CarUiRecyclerView
                android:id="@+id/unlimited_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                tools:ignore="Instantiatable" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <!-- Parked-only, full-bleed video. A VideoView is added per playback and removed on teardown,
         so a restriction change takes the surface away, not just its pixels. -->
    <FrameLayout
        android:id="@+id/video_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a2ui_brand_video_stage"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/video_caption"
            style="@style/A2uiBrandSectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="@dimen/a2ui_brand_heading_margin_horizontal"
            android:text="@string/a2ui_brand_video_caption" />

        <Button
            android:id="@+id/video_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/a2ui_brand_heading_margin_horizontal"
            android:text="@android:string/cancel" />
    </FrameLayout>
</FrameLayout>
