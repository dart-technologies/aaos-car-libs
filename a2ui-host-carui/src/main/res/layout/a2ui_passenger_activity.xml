  The passenger display. A video view is added per playback and removed on teardown, as on the
  driver's stage, so a reading that forbids video takes the surface away, not just its pixels.
  Video fills the screen, centre-cropped (never letterboxed); its credit sits at the top on a soft
  scrim, clear of any captions a film burns in along its bottom. No header: the screen is the
  passenger's, edge to edge.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/a2ui_passenger_idle_background">

    <!-- Clips the centre-cropped video to the screen. -->
    <FrameLayout
        android:id="@+id/passenger_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true" />

    <!-- Idle or held: a small "Passenger screen" label over one muted line, centred under a
         short accent rule. -->
    <LinearLayout
        android:id="@+id/passenger_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/a2ui_space_xl">

        <View
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_marginBottom="@dimen/a2ui_space_m"
            android:alpha="0.7"
            android:background="@color/a2ui_brand_accent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/passenger_idle_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/a2ui_space_s"
            android:alpha="0.8"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/a2ui_passenger_idle_label"
            android:textColor="@color/a2ui_brand_on_surface_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/passenger_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/a2ui_passenger_idle"
            android:textColor="@color/a2ui_brand_on_surface_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Credit for what is playing: top-left over the video on its own soft scrim, so it never
         meets the captions a film burns in along its bottom. -->
    <TextView
        android:id="@+id/passenger_credit"
        style="@style/A2uiBrandCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:alpha="0.85"
        android:background="@drawable/a2ui_passenger_credit_scrim"
        android:ellipsize="end"
        android:gravity="start|top"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/a2ui_space_m"
        android:paddingTop="@dimen/a2ui_space_m"
        android:paddingBottom="48dp"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
