  The passenger display. A video view is added per playback and removed on teardown, as on the
  driver's stage, so a reading that forbids video takes the surface away, not just its pixels.
  Video fills the screen, centre-cropped (never letterboxed); its credit sits over it on a soft
  scrim. No header: the screen is the passenger's, edge to edge.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/a2ui_passenger_idle_background">

    <!-- Clips the centre-cropped video to the screen. -->
    <FrameLayout
        android:id="@+id/passenger_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true" />

    <!-- Stills, when the passenger media is a slideshow. -->
    <FrameLayout
        android:id="@+id/passenger_gallery"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/a2ui_brand_video_stage"
        android:visibility="gone">

        <ImageView
            android:id="@+id/passenger_gallery_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.35"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/passenger_gallery_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="170dp"
            android:paddingHorizontal="@dimen/a2ui_space_m"
            android:paddingTop="@dimen/a2ui_space_xl"
            android:scaleType="fitCenter" />

        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="bottom"
            android:background="@drawable/a2ui_scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/a2ui_space_l"
            android:paddingBottom="@dimen/a2ui_space_xl">

            <TextView
                android:id="@+id/passenger_gallery_title"
                style="@style/A2uiBrandTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/passenger_gallery_caption"
                style="@style/A2uiBrandBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/passenger_gallery_credit"
                style="@style/A2uiBrandCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/a2ui_space_xs"
                android:alpha="0.8"
                android:maxLines="1"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/passenger_gallery_counter"
            style="@style/A2uiBrandStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/a2ui_space_m" />
    </FrameLayout>

    <!-- Idle or held: one muted line, centred under a short accent rule. -->
    <LinearLayout
        android:id="@+id/passenger_idle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/a2ui_space_xl">

        <View
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_marginBottom="@dimen/a2ui_space_m"
            android:alpha="0.7"
            android:background="@color/a2ui_brand_accent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/passenger_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/a2ui_passenger_idle"
            android:textColor="@color/a2ui_brand_on_surface_muted"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Credit for what is playing, over the video on its own soft scrim. -->
    <TextView
        android:id="@+id/passenger_credit"
        style="@style/A2uiBrandCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0.85"
        android:background="@drawable/a2ui_passenger_credit_scrim"
        android:ellipsize="end"
        android:gravity="center_horizontal|bottom"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/a2ui_space_m"
        android:paddingTop="56dp"
        android:paddingBottom="@dimen/a2ui_space_m"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
