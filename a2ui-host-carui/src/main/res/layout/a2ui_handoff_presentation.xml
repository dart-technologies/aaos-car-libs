  The handed-off surface, on the display it was handed to. One list, not two: the comparison being
  made here is against the OTHER DISPLAY, which is a metre away, rather than against a second column.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/handoff_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/a2ui_diagnostic_padding_horizontal"
        android:paddingVertical="@dimen/a2ui_diagnostic_padding_vertical"
        android:textSize="@dimen/a2ui_diagnostic_text_size"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:text="@string/handoff_label" />

    <!--
      Filled by CarUiRecyclerView.create(): the CarUiRecyclerView tag is an interface that only an
      Activity's car-ui-lib inflater factory resolves, and a Presentation has no such factory.
    -->
    <FrameLayout
        android:id="@+id/handoff_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
