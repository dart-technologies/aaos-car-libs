<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required: without the templates host nothing can render this app. -->
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="true" />

    <!-- AAOS-only track: Play distributes this to cars with Google built-in, never to phones. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- Reading UX restrictions needs no permission; car-ui-lib's CarUxRestrictionsUtil binds to
         car service, which any app may do for the restriction service. -->

    <!-- For SpeechRecognizerBinding; requested at first use via CarContext.requestPermissions
         (there is no app Activity). Without the declaration checkSelfPermission can never be
         GRANTED. `adb shell pm grant art.dart.a2ui.carapp android.permission.RECORD_AUDIO` also
         works. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- PlaceListMap/Map templates crash without this (SecurityException from the host call
         dispatcher — found on the AAOS emulator, not in unit tests). The templates host grants
         it to approved categories; on the emulator `adb shell pm grant art.dart.a2ui.carapp
         androidx.car.app.MAP_TEMPLATES` does it. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <!-- Navigation/route-preview templates need this the way map templates need MAP_TEMPLATES
         (same host-call-dispatcher rule; declared before first use, not after a crash). -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_media_play"
        android:appCategory="audio"
        android:allowBackup="false">

        <!-- The level the code needs, not the newest: the host refuses to bind an app declaring a
             level it cannot serve. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />

        <!-- The host's entire view of this app's styling: two accent colours. See themes.xml. -->
        <meta-data
            android:name="androidx.car.app.theme"
            android:resource="@style/CarAppTheme" />

        <service
            android:name="art.dart.a2ui.carapp.A2uiCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <!-- From androidx.car.app:app-automotive: the AAOS launcher entry, binding to the on-device
             templates host. AAOS-only: there is no projected-mode service. -->
        <activity
            android:name="androidx.car.app.activity.CarAppActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Without this the launcher hides the app while the vehicle moves. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
