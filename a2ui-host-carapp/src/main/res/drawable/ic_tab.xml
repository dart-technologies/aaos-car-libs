  A tab marker: a plain disc. A TabTemplate requires an icon per tab, and the
  wire carries no tab art, so the host marks every tab identically and the tab
  titles do the distinguishing. Drawn here for the same reason as ic_voice: a
  plain white vector in this app's own package is the only form that survives
  crossing into the templates host process; the host tints it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,12m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />
</vector>
