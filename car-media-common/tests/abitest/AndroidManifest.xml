  Declares the browse-service fixture so a MediaBrowser can resolve and bind it.

  The fixture is instrumented rather than Robolectric because on API >= 26 MediaBrowserCompat
  delegates to the framework android.media.browse.MediaBrowser, whose binding Robolectric does not
  emulate. Shadowing that class would mean measuring browse behaviour against an emulation of the
  platform, so it runs where the platform is real.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name="com.android.car.media.common.source.FakeLegacyBrowseService"
            android:exported="false">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
    </application>
</manifest>
